#!/bin/sh
# runit stage 1 — one-time system initialization
# All binaries are in /bin

PATH=/bin

# Mount kernel filesystems
mount -t proc proc /proc -o nosuid,noexec,nodev
mount -t sysfs sysfs /sys -o nosuid,noexec,nodev
mount -t devtmpfs devtmpfs /dev -o nosuid,noexec,mode=0755
mount -t tmpfs tmpfs /run -o nosuid,noexec,nodev,mode=0755

# Create /dev subdirectories
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts -o nosuid,noexec,gid=5,mode=0620
mount -t tmpfs tmpfs /dev/shm -o nosuid,noexec,nodev,mode=1777

# Create service directory symlink. -n: from the second boot on, /service
# already exists, and plain -sf would follow it and create
# /etc/service/service, which runsvdir then supervises as a service (with a
# supervise/ dir of its own). Remove that if an earlier boot left it.
if [ -L /etc/service/service ]; then
	rm -f /etc/service/service
	rm -rf /etc/service/supervise
fi
ln -sfn /etc/service /service 2>/dev/null || true

# Set hostname
cat /etc/hostname 2>/dev/null > /proc/sys/kernel/hostname 2>/dev/null || echo linux-libre > /proc/sys/kernel/hostname

# Configure loopback
ip link set lo up 2>/dev/null || true

# Host shared folder (9p, mount tag "share") when the VM runner provides one
if grep -qs share /sys/bus/virtio/devices/*/mount_tag; then
	mkdir -p /mnt/shared
	mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144 share /mnt/shared 2>/dev/null || true
fi

# Make sure /etc/runit/stopit exists
touch /etc/runit/stopit
chmod 0 /etc/runit/stopit

# Run boot diagnostics
/etc/runit/diag.sh 2>/dev/null || true

exit 0
